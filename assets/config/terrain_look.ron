// How the terrain types look (WP2.2). Read by sf_render::terrain_look.
//
// One entry per terrain type of terrain_types.ron, matched by `terrain` (the
// type's name, not its id). The colours are invented and procedural: every
// look is a small tileable texture drawn from a base colour and a pattern
// (flat colours with a little variation, in the style of the low-poly art
// brief); there are no third-party textures. A type without an entry is still
// drawn: its colour is derived from its name.
//
// The picture is chosen to read from 45 to 80 degrees and to stay apart from
// the unit colours of the factions (sand, olive and weathered blue; slate,
// charcoal and muted crimson, content/world.md): fresh yellow-green grass,
// a light tan road of packed earth, saturated blue water, mid grey rock, dark gold ore and a
// light wooden bridge.
//
// The minimap (WP2.3) draws every cell in one flat colour of its type, taken
// from here: `minimap: (r, g, b)` if a look names one, otherwise `color`. Only
// a look whose texture averages far from its base colour needs it (ore, with
// its bright flecks). Tests keep each minimap colour near the mean of its
// texture, at least 50 apart from every other type, and saying what the type
// is (water blue, ore warm, rock grey, ...).
(
    // Where two types meet (see docs/rules/terrain.md, "How it is drawn").
    edge: (
        // Width of the soft transition between two neighbouring cells, in
        // metres, centred on the cell border. A cell is 4 m, so 2 m keeps the
        // middle of every cell pure and the borders soft.
        ramp_m: 2.0,
        // How far the border wanders, in metres, so a staircase of cells does
        // not look like a chessboard. 0 = straight borders.
        wobble_m: 0.7,
        // Colour (linear 0..1) and strength of the light band along a shore,
        // where a `liquid` type meets another type.
        shore: (0.80, 0.93, 0.96),
        shore_amount: 0.40,
    ),
    // How much ore a cell holds (WP7.1, docs/rules/economy.md): a cell of the `terrain` type
    // below is drawn from the first level whose `up_to_percent` is at least its fill (percent
    // of the cell maximum in ore.ron), on the map and on the minimap. The ground colour and
    // the share of bright flecks fall with the fill; an empty cell is bare ground. The type
    // needs a look with the Flecks pattern. Level 0 is the empty cell (up_to_percent 0), the
    // last level ends at 100. Only a world with ore rules shows the levels; a map drawn
    // without ore state keeps the plain look of the type.
    resource: (
        terrain: "ore",
        levels: [
            (up_to_percent: 0, color: (84, 64, 44), flecks_percent: 0, minimap: (84, 64, 44)),
            (up_to_percent: 33, color: (90, 63, 38), flecks_percent: 30, minimap: (104, 76, 40)),
            (up_to_percent: 66, color: (94, 65, 36), flecks_percent: 65, minimap: (122, 88, 40)),
            (up_to_percent: 100, color: (98, 66, 34), flecks_percent: 100, minimap: (138, 100, 39)),
        ],
    ),
    looks: [
        (
            terrain: "grass",
            color: (82, 138, 54),
            contrast: 0.30,
            pattern: Noise,
        ),
        (
            // Packed earth: light tan, clearly apart from the grey rock.
            terrain: "road",
            color: (206, 184, 132),
            contrast: 0.16,
            pattern: Noise,
        ),
        (
            // Drawn flat (no hill shading, the river bed's slope does not show)
            // with a light line along the shore.
            terrain: "water",
            color: (40, 108, 164),
            contrast: 0.14,
            pattern: Ripples,
            flat: true,
            liquid: true,
        ),
        (
            terrain: "rock",
            color: (132, 128, 124),
            contrast: 0.38,
            pattern: Cracks,
        ),
        (
            terrain: "ore",
            color: (98, 66, 34),
            contrast: 0.22,
            pattern: Flecks(color: (244, 190, 52)),
            // The mean of the texture: the flecks make ore read gold-brown.
            minimap: (138, 100, 39),
        ),
        (
            // A deck: flat, with planks across the tile.
            terrain: "bridge",
            color: (202, 142, 76),
            contrast: 0.10,
            pattern: Planks(count: 8),
            flat: true,
        ),
    ],
)
