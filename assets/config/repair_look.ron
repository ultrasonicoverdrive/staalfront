// How repair and sale are shown on the map (WP6.6, docs/rules/repair_sell.md). Read by
// sf_data::repair_look, compiled into the game, checked when it is parsed. Presentation only: the
// numbers of repair and sale are repair.ron, the buttons of the sidebar are sidebar.ron, and no
// checksum depends on this file. Colours sRGB, alpha last; sizes in logical pixels (the UI scale
// is applied on top).
(
    // The progress bar of a sale, under the front edge of the structure like the construction bar
    // and the storage bar. `gap_px` is larger than theirs so that it does not cover the storage bar
    // of a refinery being sold. No bar when the edge is narrower than `min_width_px` on the screen.
    sale_bar: (
        fill: (255, 200, 60, 240),
        back: (10, 14, 20, 190),
        height_px: 6,
        min_width_px: 18,
        max_width_px: 220,
        gap_px: 12,
    ),
    // The repair sign: a square badge with a plus, floating `lift_px` above the middle of the
    // structure while it repairs. Nothing when the structure's front edge is narrower than
    // `min_width_px` on the screen. The plus is two bars of `plus_pct` percent of the badge, `plus_px`
    // thick. While the owner cannot pay the sign takes the `waiting_*` colours.
    sign: (
        size_px: 20,
        lift_px: 30,
        min_width_px: 18,
        plus_pct: 64,
        plus_px: 4,
        back: (24, 84, 36, 235),
        plus: (150, 255, 160, 255),
        waiting_back: (120, 44, 24, 235),
        waiting_plus: (255, 176, 126, 255),
    ),
    // What the line under the top bar says while a mode is on.
    hint_repair: "Repair: click one of your structures (right click or Esc to leave)",
    hint_sell: "Sell: click one of your structures (right click or Esc to leave)",
)
