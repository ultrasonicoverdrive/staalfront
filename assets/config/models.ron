// glTF model packs (WP1.10). `sf_game --models <pack>` draws the units with
// the models of that pack instead of the placeholder shapes of units.ron
// (whose palette, icon and level settings still apply). Unit kind `i` gets
// model `i` of the list (wrapping around); `icon` is that kind's strategic
// icon (Square, Circle or Triangle).
//
// `dir` is relative to `assets/`, `file` to `dir`. `axes` says where the
// source has its front and up and how many metres one unit is; the loader
// converts to the engine convention (metres, +Y up, front +X, ground at
// Y = 0; docs/conventions.md) once, on load. The glTF spec puts the front at
// +Z (`front: PlusZ`); the test pack was authored front +X already.
// `lod_px`: a model's level i is drawn while its projected bounding diameter
// is at least lod_px[i] pixels (the test pack's `screenPixelMin` extras).
(
    packs: {
        "testpack": (
            dir: "testpack_v1",
            axes: (front: PlusX, up: PlusY, metres_per_unit: 1.0),
            lod_px: [60.0, 30.0],
            models: [
                (file: "models/verkenner.glb", icon: Triangle),
                (file: "models/pantserwagen.glb", icon: Triangle),
                (file: "models/lichte_tank.glb", icon: Triangle),
                (file: "models/gevechtstank.glb", icon: Triangle),
                (file: "models/zware_tank.glb", icon: Triangle),
                (file: "models/mobiele_artillerie.glb", icon: Triangle),
                (file: "models/raketwagen.glb", icon: Triangle),
                (file: "models/luchtafweerwagen.glb", icon: Triangle),
                (file: "models/grondstofwagen.glb", icon: Triangle),
                (file: "models/bouwvoertuig.glb", icon: Triangle),
                (file: "models/energiecentrale.glb", icon: Square),
                (file: "models/raffinaderij.glb", icon: Square),
                (file: "models/voertuigfabriek.glb", icon: Square),
                (file: "models/verdedigingstoren.glb", icon: Square),
            ],
        ),
        // The third art delivery (Tijmen, 17-10-2026): 14 infantry, the four
        // ore field stages, rocks, trees and wrecks, all in engine axes
        // already (front +X, up +Y, metres) with three LODs each. Infantry
        // wander (Circle); decor and wrecks stand still (Square: in
        // `sf_game` a Square icon makes a model a fixed object near the base
        // centre). Set v4 below replaced it in `unit_defs.ron` (`model` /
        // `models` per faction, docs/rules/units.md); only demolition_team
        // still uses a set v3 file. The decor and the wrecks are not unit roles
        // and wait for the map WPs.
        "set_v3": (
            dir: "set_v3",
            axes: (front: PlusX, up: PlusY, metres_per_unit: 1.0),
            lod_px: [60.0, 30.0],
            models: [
                (file: "meridian_engineer.glb", icon: Circle),
                (file: "meridian_rifleman.glb", icon: Circle),
                (file: "meridian_rocket_trooper.glb", icon: Circle),
                (file: "meridian_scout.glb", icon: Circle),
                (file: "meridian_sniper.glb", icon: Circle),
                (file: "neutral_civilian.glb", icon: Circle),
                (file: "neutral_technician.glb", icon: Circle),
                (file: "veyran_combat_engineer.glb", icon: Circle),
                (file: "veyran_demolition_team.glb", icon: Circle),
                (file: "veyran_engineer.glb", icon: Circle),
                (file: "veyran_medic.glb", icon: Circle),
                (file: "veyran_rifleman.glb", icon: Circle),
                (file: "veyran_rocket_trooper.glb", icon: Circle),
                (file: "veyran_scout.glb", icon: Circle),
                (file: "neutral_ore_field_stage_01.glb", icon: Square),
                (file: "neutral_ore_field_stage_02.glb", icon: Square),
                (file: "neutral_ore_field_stage_03.glb", icon: Square),
                (file: "neutral_ore_field_stage_04.glb", icon: Square),
                (file: "neutral_rock_large.glb", icon: Square),
                (file: "neutral_rock_small.glb", icon: Square),
                (file: "neutral_tree_broadleaf.glb", icon: Square),
                (file: "neutral_tree_broadleaf_burnt.glb", icon: Square),
                (file: "neutral_tree_broadleaf_fallen.glb", icon: Square),
                (file: "neutral_tree_pine.glb", icon: Square),
                (file: "neutral_tree_pine_burnt.glb", icon: Square),
                (file: "neutral_tree_pine_fallen.glb", icon: Square),
                (file: "neutral_wreck_heavy_vehicle.glb", icon: Square),
                (file: "neutral_wreck_light_vehicle.glb", icon: Square),
                (file: "neutral_wreck_medium_vehicle.glb", icon: Square),
                (file: "neutral_wreck_vessel.glb", icon: Square),
            ],
        ),
        // Art set v4 (integrated 21-10-2026; the producer calls the delivery
        // "GLB pakket v3", which would clash with set v3 above):
        // the 194 models of the delivery that pass `sf_asset_check` (the
        // checker's findings on the rest are in docs/progress.md). It replaces
        // set v3 as the placeholder pack: the units, structures and objects of
        // `unit_defs.ron` are wired to it (`model` / `models`), except where the
        // set has no usable model (demolition_team stays on set v3, see
        // docs/rules/units.md). The files are byte for byte the delivery's; each
        // has one glTF scene per level (LOD0..2), which the loader reads like
        // one scene with three roots (docs/conventions.md section 12). Listed
        // by what it is: infantry (Circle) wander, vehicles (Triangle) and
        // vessels (HalfCircle) too, structures, damage states, objects and
        // decor (Square) stand still. `--crowd --models set_v4` draws the whole list;
        // the damage states (_damaged, _foundation, ...) are not roles of
        // `unit_defs.ron` and wait for the building WPs.
        "set_v4": (
            dir: "set_v4",
            axes: (front: PlusX, up: PlusY, metres_per_unit: 1.0),
            lod_px: [60.0, 30.0],
            models: [
                // infantry
                (file: "meridian_engineer.glb", icon: Circle),
