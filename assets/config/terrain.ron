// Terrain level of detail (WP1.8). Read by sf_render::lod::TerrainConfig.
//
// Every 32x32-cell chunk has six meshes (steps of 1, 2, 4, 8, 16 and 32 cells,
// levels 0 to 5) with a known geometric error in metres. Each frame a chunk
// takes the coarsest level whose error, projected to the screen, is at most
// `error_px` pixels (conservative: measured at the nearest point of the
// chunk, in the render target's own pixels).
(
    lod: (
        // Largest projected error in pixels. Default tuned for 1920x1080.
        error_px: 2.0,
        // A chunk goes coarser only if the coarser level fits in
        // error_px * (1 - hysteresis); 0 = no hysteresis (levels may flicker).
        hysteresis: 0.25,
        // What one more draw call is worth, in triangles. The planner draws a
        // chunk finer than the budget needs when that joins draw calls and costs
        // fewer extra triangles than this. 0 = never (more draw calls).
        draw_call_cost: 300.0,
        // Debug: draw every chunk at this level, e.g. Some(0) for full detail.
        force_level: None,
    ),
    // Debug: false removes the skirts under the chunk edges and so shows the
    // cracks between chunks of different levels.
    seams: true,
)
