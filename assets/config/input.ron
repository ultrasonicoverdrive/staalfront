// Input bindings: raw input -> engine-generic action names.
// Hot-reloaded in debug builds (save the file while the game runs).
//
// Triggers: Key(<winit KeyCode>), Mouse(Left|Right|Middle|Back|Forward),
//           WheelUp, WheelDown, EdgeLeft, EdgeRight, EdgeTop, EdgeBottom.
// `mods` (Alt, Ctrl, Shift) must all be held; extra modifiers are ignored.
(
    // Width in pixels of the screen-edge band that counts as "cursor at edge".
    edge_margin: 4,
    bindings: {
        CameraZoomIn: [(trigger: WheelUp)],
        CameraZoomOut: [(trigger: WheelDown)],
        CameraPanLeft: [(trigger: Key(KeyA)), (trigger: Key(ArrowLeft)), (trigger: EdgeLeft)],
        CameraPanRight: [(trigger: Key(KeyD)), (trigger: Key(ArrowRight)), (trigger: EdgeRight)],
        CameraPanUp: [(trigger: Key(KeyW)), (trigger: Key(ArrowUp)), (trigger: EdgeTop)],
        CameraPanDown: [(trigger: Key(KeyS)), (trigger: Key(ArrowDown)), (trigger: EdgeBottom)],
        CameraRotateLeft: [(trigger: Key(KeyQ))],
        CameraRotateRight: [(trigger: Key(KeyE))],
        CameraDrag: [(trigger: Mouse(Middle))],
        ToggleFullscreen: [(trigger: Key(F11)), (trigger: Key(Enter), mods: [Alt])],
        ToggleDebug: [(trigger: Key(F1))],
        PlayTestSound: [(trigger: Key(KeyT))],
        Quit: [(trigger: Key(Escape))],
        // Orders (WP3.4). S stays a camera key (WASD pan), so stop is on C.
        OrderMove: [(trigger: Mouse(Right))],
        OrderQueue: [(trigger: Key(ShiftLeft)), (trigger: Key(ShiftRight))],
        OrderStop: [(trigger: Key(KeyC))],
        OrderScatter: [(trigger: Key(KeyX))],
        OrderHold: [(trigger: Key(KeyH))],
        // Held: a right-click on the ground attack-moves instead of moving
        // (WP3.5). A is the camera's pan left, so the modifier is F.
        OrderAttackMove: [(trigger: Key(KeyF))],
        // Building (WP6.2). B chooses the next structure to build and, after the last
        // one, none; with one chosen the ghost follows the cursor, the select button
        // (left) places it and the order button (right) puts it away.
        BuildCycle: [(trigger: Key(KeyB))],
        // Selection (WP3.3). SelectClick: a click selects, a drag draws the
        // selection rectangle (own mobile units in it), a double-click
        // selects the units of the same kind in view. SelectAdd (held): a
        // click toggles the unit in the selection, a drag or a double-click
        // adds to it. It shares shift with OrderQueue on purpose: one is read
        // with a click, the other with an order.
        SelectClick: [(trigger: Mouse(Left))],
        SelectAdd: [(trigger: Key(ShiftLeft)), (trigger: Key(ShiftRight))],
        // Control groups. GroupAssign (held) + a number assigns the selection
        // to that group; the number alone recalls it; a double tap of the
        // number also centres the camera on the group.
        GroupAssign: [(trigger: Key(ControlLeft)), (trigger: Key(ControlRight))],
        Group1: [(trigger: Key(Digit1)), (trigger: Key(Numpad1))],
        Group2: [(trigger: Key(Digit2)), (trigger: Key(Numpad2))],
        Group3: [(trigger: Key(Digit3)), (trigger: Key(Numpad3))],
        Group4: [(trigger: Key(Digit4)), (trigger: Key(Numpad4))],
        Group5: [(trigger: Key(Digit5)), (trigger: Key(Numpad5))],
        Group6: [(trigger: Key(Digit6)), (trigger: Key(Numpad6))],
        Group7: [(trigger: Key(Digit7)), (trigger: Key(Numpad7))],
        Group8: [(trigger: Key(Digit8)), (trigger: Key(Numpad8))],
        Group9: [(trigger: Key(Digit9)), (trigger: Key(Numpad9))],
    },
)
