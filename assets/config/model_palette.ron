// The palette of art set v5 (WP11.6a; style G "semi-realistic, muted" since WP11.6p, decision
// Tijmen 15-11-2026; docs/art-style.md). Read by tools/sf_model_gen (the models) and by its cutscene part generator.
// sRGB 0..255. One entry per surface type, so a later texture step can keep the material slots:
// `paint` (main hull paint), `paint2` (second paint), `metal` (gun steel, fittings), `rubber`
// (tracks, tyres, running gear), `accent` (a small fixed faction mark; glass on Meridian).
// `team` is not here: it is the engine's player colour; the file only stores its neutral base.
(
    factions: {
        "meridian": (
            paint: (178, 160, 136),
            paint_light: (200, 186, 164),
            paint2: (94, 88, 56),
            paint2_shade: (69, 66, 46),
            metal: (60, 57, 50),
            rubber: (46, 44, 40),
            accent: (62, 74, 82),
        ),
        "veyran": (
            paint: (108, 122, 138),
            paint_light: (136, 150, 164),
            paint2: (60, 66, 76),
            paint2_shade: (78, 83, 90),
            metal: (58, 61, 67),
            rubber: (46, 44, 40),
            accent: (122, 30, 40),
        ),
        // The figures of WP11.6i (round 2, Tijmen 28-11-2026: "the v5 riflemen read almost black"):
        // their own entries, so the vehicles keep their colours. paint = uniform, paint2 = helmet,
        // webbing and pack, metal = gunmetal of the rifle, rubber = boots and belt, accent = skin
        // (the figure has no free slot for Veyran's crimson mark: six materials at most).
        // `paint_light` and `paint2_shade` are not used by the figures; they repeat paint/paint2.
        "meridian_figure": (
            paint: (216, 200, 162),
            paint_light: (216, 200, 162),
            paint2: (146, 142, 94),
            paint2_shade: (146, 142, 94),
            metal: (66, 66, 68),
            rubber: (76, 66, 54),
            accent: (196, 150, 118),
        ),
        "veyran_figure": (
            paint: (170, 186, 204),
            paint_light: (170, 186, 204),
            paint2: (118, 128, 146),
            paint2_shade: (118, 128, 146),
            metal: (66, 66, 68),
            rubber: (50, 52, 56),
            accent: (192, 148, 118),
        ),
        // Neutral models (WP11.6b: the supply truck, the ferry) have no team material; the third
        // slot is a second light paint instead (`paint3`, the `paint_light` colour).
        "neutral": (
            paint: (136, 142, 128),
            paint_light: (158, 164, 148),
            paint2: (86, 90, 76),
            paint2_shade: (66, 70, 60),
            metal: (66, 65, 60),
            rubber: (46, 44, 40),
            accent: (122, 74, 48),
        ),
        // Plants (WP11.6d: the broadleaf tree and its fallen twin; no team material either):
        // paint = foliage, paint2 = shaded foliage, paint_light = sunlit foliage (the `paint3`
        // slot), metal = bark, rubber = soil, accent = dry leaves. Dark olive greens, muted.
        "flora": (
            paint: (86, 98, 70),
            paint_light: (104, 116, 86),
            paint2: (60, 70, 48),
            paint2_shade: (72, 82, 58),
            metal: (62, 52, 42),
            rubber: (46, 44, 40),
            accent: (118, 96, 58),
        ),
        // The automated Network defences (WP11.6c: the automated gun, the unmanned artillery):
        // graphite plates with an amber lamp; they carry the player colour like a faction.
        "network": (
            paint: (74, 76, 80),
            paint_light: (92, 95, 100),
            paint2: (48, 50, 55),
            paint2_shade: (60, 63, 70),
            metal: (50, 50, 55),
            rubber: (46, 44, 40),
            accent: (138, 100, 32),
        ),
    },
    // The base colour stored in the team material (the engine replaces it with the player colour).
    team_base: (235, 235, 235),
)
