// Visual effects (WP5.6a): which particles a shot, a hit and a death make. Read by sf_data::effects, compiled into
// the game, and checked when it is parsed (every effect named below exists; every damage type of
// unit_classes.ron has an entry; every by_weapon key is a weapon id of weapon_defs.ron; unknown fields are
// refused). Presentation only: nothing here reaches the simulation, so no checksum depends on it.
// What every field means and how zoom changes it: docs/rules/effects.md.
//
//   Sizes are metres across (a cell is 4 m), times are seconds, speeds are metres per second.
//   glow: true   additive light (flash, fire, spark); false is the "smoke class": normal alpha, and refused
//                when the particle pool is more than `smoke_refuse_percent` full so that flashes keep room.
//   sound        the event name the audio of WP11.7 hooks onto (dotted, lower case); "" is silent. A name is
//                used by one effect only, so an event name says which effect it came from.
(
    limits: (
        // The one particle pool: a ring, the oldest particle goes when it is full (counted in the F1 panel).
        max_particles: 4096,
        // Tracer dots from the projectiles in flight, drawn in the same call; the buffer is made once at
        // max_particles + max_tracer_dots.
        max_tracer_dots: 2048,
        // A particle is drawn between these sizes on the screen, whatever the zoom (physical pixels).
        min_px: 2.0,
        max_px: 64.0,
        // Below this apparent size of the 2 m reference unit (pixels) the zoom counts as "middle".
        middle_below_px: 60.0,
        // The share of a burst's particles that is made at middle zoom (rounded up, at least one).
        middle_factor: 0.5,
        // Smoke is refused above this share of the pool.
        smoke_refuse_percent: 75,
        // The alpha a death flash keeps at strategic zoom, where everything else has faded out.
        strategic_flash_alpha: 0.6,
        // An event older than this many ticks when the picture takes it is dropped (a window that was
        // minimised does not set off a backlog of explosions).
        max_event_age_ticks: 40,
        // Curve shapes. A particle rises at rise_mps times a factor in 1 ± rise_jitter / 2; smoke's alpha comes
        // in over the first 1 / smoke_fade_in of its life; a death flash holds over the first flash_hold of its
        // life; the last tracer dot is (1 - tracer_taper) of the head's size and alpha.
        rise_jitter: 0.4,
        smoke_fade_in: 8.0,
        flash_hold: 0.5,
        tracer_taper: 0.6,
    ),

    // Where the flash starts when the model has no muzzle anchor (a model with a `muzzle*` node, WP5.6b, uses it
    // instead; the rule is for the test pack, set v3 and the placeholder shapes): from the unit's middle,
    // along the weapon's mount (hull or turret facing), `reach_fraction` of the body length out (at least
    // `min_reach_m`), at `height_fraction` of the body length above the ground. The body length is the
    // unit's size in the definitions (cells times 4 m): the bounding box's length without reading the model.
    muzzle: (reach_fraction: 0.5, height_fraction: 0.22, min_reach_m: 0.8),

    // Where hits and deaths burst: hit_height_m above the ground (wreck smoke too), in a disc of the event's
    // size times impact_radius_fraction (a hit) or death_radius_fraction (a death), at least min_burst_radius_m.
    // A projectile that flies on the ground is drawn projectile_lift_m up, the muzzle's height.
    // A death bursts death_lift_m higher still (WP5.6b, a review observation of WP5.6a): the blast of a
    // body starts above the wreck it leaves, not in it.
    placement: (
        hit_height_m: 0.6,
        death_lift_m: 0.5,
        projectile_lift_m: 1.0,
        impact_radius_fraction: 0.5,
        death_radius_fraction: 0.4,
        min_burst_radius_m: 0.3,
    ),

    effects: {
        // Muzzle flashes (fire).
        "flash_bullet":       (count: 1,  life_s: 0.08, size_m: 0.9, growth_mps: 3.0,  colour: (255, 226, 150), alpha: 1.0, glow: true,  rise_mps: 0.0, spread_mps: 0.0, sound: "weapon.fire.bullet"),
        "flash_precision":    (count: 1,  life_s: 0.06, size_m: 0.7, growth_mps: 2.0,  colour: (255, 250, 220), alpha: 1.0, glow: true,  rise_mps: 0.0, spread_mps: 0.0, sound: "weapon.fire.precision"),
        "flash_cannon":       (count: 3,  life_s: 0.14, size_m: 1.8, growth_mps: 6.0,  colour: (255, 200, 110), alpha: 1.0, glow: true,  rise_mps: 0.0, spread_mps: 2.0, sound: "weapon.fire.cannon"),
        "flash_rocket":       (count: 3,  life_s: 0.22, size_m: 1.4, growth_mps: 5.0,  colour: (255, 170, 90),  alpha: 1.0, glow: true,  rise_mps: 0.0, spread_mps: 3.0, sound: "weapon.fire.rocket"),
        "flash_shell":        (count: 5,  life_s: 0.28, size_m: 2.8, growth_mps: 8.0,  colour: (255, 190, 100), alpha: 1.0, glow: true,  rise_mps: 0.0, spread_mps: 4.0, sound: "weapon.fire.shell"),
        "flash_howitzer":     (count: 7,  life_s: 0.35, size_m: 4.0, growth_mps: 10.0, colour: (255, 210, 130), alpha: 1.0, glow: true,  rise_mps: 0.0, spread_mps: 5.0, sound: "weapon.fire.howitzer"),
        "flash_demolition":   (count: 1,  life_s: 0.10, size_m: 1.0, growth_mps: 3.0,  colour: (255, 240, 200), alpha: 1.0, glow: true,  rise_mps: 0.0, spread_mps: 0.0, sound: "weapon.fire.demolition"),
        "smoke_muzzle":       (count: 2,  life_s: 0.70, size_m: 1.2, growth_mps: 2.0,  colour: (150, 150, 150), alpha: 0.40, glow: false, rise_mps: 1.0, spread_mps: 1.0, sound: ""),

        // Hits (impact).
        "spark_bullet":       (count: 3,  life_s: 0.16, size_m: 0.5, growth_mps: 2.0,  colour: (255, 220, 150), alpha: 1.0, glow: true,  rise_mps: 1.5, spread_mps: 4.0, sound: "impact.bullet"),
        "spark_precision":    (count: 3,  life_s: 0.18, size_m: 0.5, growth_mps: 2.0,  colour: (255, 245, 210), alpha: 1.0, glow: true,  rise_mps: 1.5, spread_mps: 3.0, sound: "impact.precision"),
        "blast_cannon":       (count: 4,  life_s: 0.32, size_m: 2.0, growth_mps: 7.0,  colour: (255, 170, 80),  alpha: 1.0, glow: true,  rise_mps: 1.0, spread_mps: 4.0, sound: "impact.cannon"),
        "blast_rocket":       (count: 5,  life_s: 0.40, size_m: 2.4, growth_mps: 8.0,  colour: (255, 150, 70),  alpha: 1.0, glow: true,  rise_mps: 1.0, spread_mps: 4.0, sound: "impact.rocket"),
        "blast_shell":        (count: 8,  life_s: 0.50, size_m: 3.6, growth_mps: 9.0,  colour: (255, 160, 70),  alpha: 1.0, glow: true,  rise_mps: 1.0, spread_mps: 6.0, sound: "impact.shell"),
        "blast_demolition":   (count: 10, life_s: 0.60, size_m: 5.0, growth_mps: 10.0, colour: (255, 150, 60),  alpha: 1.0, glow: true,  rise_mps: 1.0, spread_mps: 8.0, sound: "impact.demolition"),
        "smoke_blast":        (count: 4,  life_s: 1.20, size_m: 2.2, growth_mps: 3.0,  colour: (110, 105, 100), alpha: 0.50, glow: false, rise_mps: 2.0, spread_mps: 2.0, sound: ""),
        "dust_puff":          (count: 3,  life_s: 0.80, size_m: 1.4, growth_mps: 2.5,  colour: (165, 140, 105), alpha: 0.45, glow: false, rise_mps: 0.8, spread_mps: 2.5, sound: "impact.miss"),

        // Deaths.
        "pop_infantry":       (count: 3,  life_s: 0.35, size_m: 1.0, growth_mps: 3.0,  colour: (255, 200, 120), alpha: 1.0, glow: true,  rise_mps: 1.0, spread_mps: 3.0, sound: "unit.destroyed.infantry"),
        "explosion_small":    (count: 6,  life_s: 0.45, size_m: 2.2, growth_mps: 7.0,  colour: (255, 160, 70),  alpha: 1.0, glow: true,  rise_mps: 1.5, spread_mps: 4.0, sound: "explosion.small"),
        "explosion_medium":   (count: 9,  life_s: 0.60, size_m: 3.0, growth_mps: 8.0,  colour: (255, 150, 60),  alpha: 1.0, glow: true,  rise_mps: 1.5, spread_mps: 5.0, sound: "explosion.medium"),
        "explosion_large":    (count: 14, life_s: 0.90, size_m: 6.0, growth_mps: 10.0, colour: (255, 140, 50),  alpha: 1.0, glow: true,  rise_mps: 2.0, spread_mps: 9.0, sound: "explosion.large"),
        "smoke_death":        (count: 5,  life_s: 1.80, size_m: 3.0, growth_mps: 3.5,  colour: (80, 78, 75),    alpha: 0.55, glow: false, rise_mps: 2.5, spread_mps: 3.0, sound: ""),

        // What a damaged object gives off while it stands (WP6.8, damage.ron): dark smoke that climbs slowly, and
        // flames that flicker up and are gone.
        "damage_smoke":       (count: 1,  life_s: 3.00, size_m: 3.2, growth_mps: 1.8,  colour: (40, 38, 36),    alpha: 0.70, glow: false, rise_mps: 2.6, spread_mps: 0.5, sound: ""),
        "damage_fire":        (count: 1,  life_s: 0.80, size_m: 2.8, growth_mps: 0.8,  colour: (255, 150, 50),  alpha: 1.0,  glow: true,  rise_mps: 2.0, spread_mps: 0.5, sound: ""),
        // What a wreck gives off while it lies, and what a rocket leaves behind it.
        "smoke_wreck":        (count: 1,  life_s: 2.00, size_m: 2.0, growth_mps: 2.0,  colour: (70, 68, 66),    alpha: 0.35, glow: false, rise_mps: 2.0, spread_mps: 0.5, sound: ""),
        "trail_smoke":        (count: 1,  life_s: 0.80, size_m: 0.6, growth_mps: 1.5,  colour: (190, 190, 190), alpha: 0.35, glow: false, rise_mps: 0.3, spread_mps: 0.3, sound: ""),
    },

    // By the damage type of the weapon (the names of unit_classes.ron): the effects of a shot at the muzzle and
    // of a hit where it lands. Every damage type has one.
    by_damage_type: {
        "bullet":     (fire: ["flash_bullet"],                       impact: ["spark_bullet"]),
        "precision":  (fire: ["flash_precision"],                    impact: ["spark_precision"]),
        "rocket":     (fire: ["flash_rocket", "smoke_muzzle"],       impact: ["blast_rocket", "smoke_blast"]),
        "cannon":     (fire: ["flash_cannon", "smoke_muzzle"],       impact: ["blast_cannon"]),
        "shell":      (fire: ["flash_shell", "smoke_muzzle"],        impact: ["blast_shell", "smoke_blast"]),
        "demolition": (fire: ["flash_demolition"],                   impact: ["blast_demolition", "smoke_blast"]),
    },

    // A weapon (its id in weapon_defs.ron) that looks different from its damage type. A list left empty (or out)
    // keeps the damage type's.
    by_weapon: {
        "howitzer": (fire: ["flash_howitzer", "smoke_muzzle"]),
    },

    // A projectile that goes off where nothing was hit and nothing is splashed (a fuse that ran out): dust.
    miss: ["dust_puff"],

    // A destroyed unit or structure. A mobile unit with a body under `infantry_below_cells` is infantry, under
    // `small_below_cells` a small vehicle, else a vehicle; a structure is a structure.
    death: (
        infantry_below_cells: 1.0,
        small_below_cells: 1.3,
        infantry:  ["pop_infantry"],
        small:     ["explosion_small", "smoke_death"],
        vehicle:   ["explosion_medium", "smoke_death"],
        structure: ["explosion_large", "smoke_death"],
    ),

    // A wreck or rubble gives off `per_second` puffs of `effect` while it lies, and stops over the last
    // `fade_fraction` of its life. The puffs start in a disc of `radius_fraction` of the wreck's length.
    wreck_smoke: (effect: "smoke_wreck", per_second: 3.0, fade_fraction: 0.2, radius_fraction: 0.25),

    // How a projectile in flight is drawn, by the way it flies: `dots` glowing dots `spacing_m` apart behind
    // its head, and a `trail` of puffs at `trail_per_s` per second.
    tracers: (
        straight: (dots: 4, spacing_m: 0.9, size_m: 0.45, colour: (255, 235, 160), alpha: 1.0, trail: [],              trail_per_s: 0.0),
        arc:      (dots: 2, spacing_m: 0.7, size_m: 0.9,  colour: (255, 200, 120), alpha: 1.0, trail: [],              trail_per_s: 0.0),
        guided:   (dots: 5, spacing_m: 0.8, size_m: 0.55, colour: (255, 190, 120), alpha: 1.0, trail: ["trail_smoke"], trail_per_s: 30.0),
        falling:  (dots: 3, spacing_m: 1.2, size_m: 0.8,  colour: (255, 230, 170), alpha: 1.0, trail: [],              trail_per_s: 0.0),
    ),
)
