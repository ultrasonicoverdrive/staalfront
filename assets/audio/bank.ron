// Sound bank: named sounds for sf_audio. Hot-reloaded in debug builds.
//
// Each entry:
//   file:            path relative to the assets directory (forward slashes)
//   volume:          linear base volume, default 1.0
//   pitch_variation: random playback-rate spread, 0.05 = +-5 %, default 0
//   max_instances:   simultaneous voices of this sound, default 8
//   category:        Sfx | Ui | Music | Voice (volume groups, WP11.5b), default Sfx
//   looped:          repeat until stopped, default false
//   variants:        more files of the same sound; each play picks one of file and these, never the last
//                    one (WP11.2b), default none
//   original_as_is:  true = a mapped original Red Alert sound plays with volume 1, no pitch spread and the
//                    default voice cap instead of this entry's values (which suit the CC0 file), default false
//
// Every file needs a line in assets/LICENSES.md.
(
    sounds: {
        "test_click": (
            file: "audio/sfx/test_click.wav",
            volume: 0.8,
            pitch_variation: 0.05,
            max_instances: 4,
            category: Sfx,
        ),
        // Generic events (WP11.7); ra_mapping.ron can replace them with the
        // player's original Red Alert sounds. building.placed has no CC0 sound
        // yet and is silent unless mapped (no code plays it today).
        "ui.click": (
            file: "audio/sfx/test_click.wav",
            volume: 0.6,
            max_instances: 2,
            category: Ui,
        ),
        // Fight sounds (WP11.3b), one per sound event of effects.ron, generated by
        // tools/sf_sound_gen (own work, CC0; `cargo run -p sf_sound_gen` rewrites the
        // files, a test checks they are current). Every file has the same peak: the
        // volume here is the loudness of the event. WP11.3c: 0.5 to 1.0 (were 0.125 to
        // 0.35) because the originals play at 1.0 and the sounds were weak; the limiter
        // (audio.ron positional) holds a dense fight, and `a_20_tank_fight_is_not_louder_
        // than_the_music` in sf_game fx_sound.rs compares the fight's RMS with the music's.
        // Six events (weapon.fire.bullet, weapon.fire.demolition, impact.bullet,
        // impact.precision, impact.miss, unit.destroyed.infantry) have three files each
        // (`variants`). With Red Alert audio on, ra_mapping.ron still wins for the events
        // it maps (as-is, no variants); the rest play these.
        "weapon.fire.bullet": (
            file: "audio/sfx/weapon_fire_bullet.wav",
            variants: ["audio/sfx/weapon_fire_bullet_mg.wav", "audio/sfx/weapon_fire_bullet_heavy.wav"],
            volume: 0.7,
            pitch_variation: 0.06,
            max_instances: 6,
            category: Sfx,
            original_as_is: true,
        ),
        "weapon.fire.precision": (
            file: "audio/sfx/weapon_fire_precision.wav",
            volume: 0.85,
            pitch_variation: 0.04,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "weapon.fire.cannon": (
            file: "audio/sfx/weapon_fire_cannon.wav",
            volume: 0.95,
            pitch_variation: 0.05,
            max_instances: 6,
            category: Sfx,
            original_as_is: true,
        ),
        "weapon.fire.rocket": (
            file: "audio/sfx/weapon_fire_rocket.wav",
            volume: 0.85,
            pitch_variation: 0.04,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "weapon.fire.shell": (
            file: "audio/sfx/weapon_fire_shell.wav",
            volume: 0.85,
            pitch_variation: 0.05,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "weapon.fire.howitzer": (
            file: "audio/sfx/weapon_fire_howitzer.wav",
            volume: 1.0,
            pitch_variation: 0.03,
            max_instances: 3,
            category: Sfx,
            original_as_is: true,
        ),
        "weapon.fire.demolition": (
            file: "audio/sfx/weapon_fire_demolition.wav",
            variants: ["audio/sfx/weapon_fire_demolition_drop.wav", "audio/sfx/weapon_fire_demolition_slow.wav"],
            volume: 0.8,
            pitch_variation: 0.0,
            max_instances: 2,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.bullet": (
            file: "audio/sfx/impact_bullet.wav",
            variants: ["audio/sfx/impact_bullet_metal.wav", "audio/sfx/impact_bullet_ricochet.wav"],
            volume: 0.55,
            pitch_variation: 0.08,
            max_instances: 6,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.precision": (
            file: "audio/sfx/impact_precision.wav",
            variants: ["audio/sfx/impact_precision_deep.wav", "audio/sfx/impact_precision_slap.wav"],
            volume: 0.7,
            pitch_variation: 0.05,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.cannon": (
            file: "audio/sfx/impact_cannon.wav",
            volume: 0.85,
            pitch_variation: 0.05,
            max_instances: 6,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.rocket": (
            file: "audio/sfx/impact_rocket.wav",
            volume: 0.9,
            pitch_variation: 0.04,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.shell": (
            file: "audio/sfx/impact_shell.wav",
            volume: 0.85,
            pitch_variation: 0.05,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.demolition": (
            file: "audio/sfx/impact_demolition.wav",
            volume: 1.0,
            pitch_variation: 0.03,
            max_instances: 3,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.miss": (
            file: "audio/sfx/impact_miss.wav",
            variants: ["audio/sfx/impact_miss_far.wav", "audio/sfx/impact_miss_skip.wav"],
            volume: 0.5,
            pitch_variation: 0.08,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "unit.destroyed.infantry": (
            file: "audio/sfx/unit_destroyed_infantry.wav",
            variants: ["audio/sfx/unit_destroyed_infantry_shout.wav", "audio/sfx/unit_destroyed_infantry_grunt.wav"],
            volume: 0.7,
            pitch_variation: 0.06,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "explosion.small": (
            file: "audio/sfx/explosion_small.wav",
            volume: 0.8,
            pitch_variation: 0.05,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "explosion.medium": (
            file: "audio/sfx/explosion_medium.wav",
            volume: 0.95,
            pitch_variation: 0.04,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "explosion.large": (
            file: "audio/sfx/explosion_large.wav",
            volume: 1.0,
            pitch_variation: 0.03,
            max_instances: 3,
            category: Sfx,
            original_as_is: true,
        ),
        // Unit voices (WP11.2b): three lines per event, the Piper voice en_US-joe-medium
        // through our walkie-talkie filter tools/sf_voice_gen (CC0; `cargo run -p
        // sf_voice_gen` rewrites the files, a test checks they are current). Each play
        // picks one of `file` and `variants`, never the last one. Same file peak as the
        // fight sounds; the volume is set by measuring against the 20-tank fight
        // (`the_unit_voices_are_heard_over_a_fight_and_not_louder_than_its_loudest_sound`
        // in sf_game fx_sound.rs). With Red Alert audio on, a mapped line from
        // ra_mapping.ron wins and plays as-is.
        //
        // WP11.2d: more select lines, and a voice per side. `unit.select` is the Meridian voice (joe) and has nine
        // variants. The Veyran units speak with the voice en_GB-cori-high (a British woman) in the events
        // `unit.select.veyran`, `unit.move.veyran` and `unit.attack.veyran`: which event plays follows the faction
        // of the unit that speaks (sf_game unit_voice.rs). With Red Alert audio on, the mapped original of the
        // plain event wins for both sides. Rules: docs/rules/voices.md.
        "unit.select": (
            file: "audio/voice/unit_select_ready.wav",
            variants: [
                "audio/voice/unit_select_online.wav",
                "audio/voice/unit_select_standing_by.wav",
                "audio/voice/unit_select_go_ahead.wav",
                "audio/voice/unit_select_listening.wav",
                "audio/voice/unit_select_orders.wav",
                "audio/voice/unit_select_copy_that.wav",
                "audio/voice/unit_select_your_call.wav",
                "audio/voice/unit_select_on_the_line.wav",
            ],
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "unit.select.veyran": (
            file: "audio/voice/cori_unit_select_ready_to_go.wav",
            variants: [
                "audio/voice/cori_unit_select_systems_online.wav",
                "audio/voice/cori_unit_select_standing_by.wav",
                "audio/voice/cori_unit_select_go_ahead.wav",
                "audio/voice/cori_unit_select_listening_in.wav",
                "audio/voice/cori_unit_select_orders_sir.wav",
                "audio/voice/cori_unit_select_copy_sir.wav",
                "audio/voice/cori_unit_select_your_call_sir.wav",
                "audio/voice/cori_unit_select_on_the_line.wav",
            ],
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "unit.move.veyran": (
            file: "audio/voice/cori_unit_move_moving_out.wav",
            variants: [
                "audio/voice/cori_unit_move_route_set.wav",
                "audio/voice/cori_unit_move_on_my_way.wav",
            ],
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "unit.attack.veyran": (
            file: "audio/voice/cori_unit_attack_opening_fire.wav",
            variants: [
                "audio/voice/cori_unit_attack_target_locked.wav",
                "audio/voice/cori_unit_attack_engaging_now.wav",
            ],
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "unit.move": (
            file: "audio/voice/unit_move_moving.wav",
            variants: ["audio/voice/unit_move_route_set.wav", "audio/voice/unit_move_on_it.wav"],
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "unit.attack": (
            file: "audio/voice/unit_attack_engaging.wav",
            variants: ["audio/voice/unit_attack_target_locked.wav", "audio/voice/unit_attack_firing.wav"],
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        // Announcements (WP11.2c): the status lines of the player's own base ("Unit ready", "Base under
        // attack"), the same Piper voice joe through the same walkie-talkie filter as the unit voices above
        // (tools/sf_voice_gen, CC0). One file per event, played in the Voice category at the volume of the unit
        // voices (0.95), one at a time. With Red Alert audio on, a mapped line from ra_mapping.ron wins and
        // plays as-is. Rules: docs/rules/announcements.md.
        "announce.structure_ready": (
            file: "audio/voice/announce_structure_ready.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.unit_ready": (
            file: "audio/voice/announce_unit_ready.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.building": (
            file: "audio/voice/announce_building.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.training": (
            file: "audio/voice/announce_training.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.on_hold": (
            file: "audio/voice/announce_on_hold.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.cancelled": (
            file: "audio/voice/announce_cancelled.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.base_under_attack": (
            file: "audio/voice/announce_base_under_attack.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.harvester_under_attack": (
            file: "audio/voice/announce_harvester_under_attack.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.low_power": (
            file: "audio/voice/announce_low_power.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.insufficient_funds": (
            file: "audio/voice/announce_insufficient_funds.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.storage_full": (
            file: "audio/voice/announce_storage_full.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.unit_lost": (
            file: "audio/voice/announce_unit_lost.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.structure_lost": (
            file: "audio/voice/announce_structure_lost.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.new_options": (
            file: "audio/voice/announce_new_options.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.cannot_deploy": (
            file: "audio/voice/announce_cannot_deploy.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.victory": (
            file: "audio/voice/announce_victory.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.defeat": (
            file: "audio/voice/announce_defeat.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.structure_sold": (
            file: "audio/voice/announce_structure_sold.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        "announce.repairing": (
            file: "audio/voice/announce_repairing.wav",
            volume: 0.95,
            max_instances: 1,
            category: Voice,
            original_as_is: true,
        ),
        // The same file as a looping "music" track, to exercise the crossfade.
        "test_loop": (
            file: "audio/sfx/test_click.wav",
            volume: 0.5,
            category: Music,
            looped: true,
        ),
        // The own CC0 music of the two moods (WP11.4b), generated by tools/sf_music_gen (own
        // work, CC0; `cargo run -p sf_music_gen` rewrites the files, a test checks they are
        // current). Mono 22.05 kHz FLAC, about 68 s each, built to loop with no click. They
        // play when no Red Alert track is available for the mood (audio.ron, music.fallback).
        // Both files have the same peak (0.885) and about the same loudness; the volumes here
        // set the mood: combat at 1.0 sits at 0.53 of full scale at the default music volume
        // (0.6). A 20-tank fight has a steady RMS of 1.62 times the music's (at most 1.8, and at least twice what it was
        // before WP11.3c: a_20_tank_fight_is_at_most_1_8_times_the_music in sf_game fx_sound.rs); calm is 3 dB under it. Looped, one instance each.
        "music.calm": (
            file: "audio/music/calm.flac",
            volume: 0.7,
            max_instances: 1,
            category: Music,
            looped: true,
        ),
        "music.combat": (
            file: "audio/music/combat.flac",
            volume: 1.0,
            max_instances: 1,
            category: Music,
            looped: true,
        ),
    },
)
