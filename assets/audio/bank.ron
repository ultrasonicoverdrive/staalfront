// Sound bank: named sounds for sf_audio. Hot-reloaded in debug builds.
//
// Each entry:
//   file:            path relative to the assets directory (forward slashes)
//   volume:          linear base volume, default 1.0
//   pitch_variation: random playback-rate spread, 0.05 = +-5 %, default 0
//   max_instances:   simultaneous voices of this sound, default 8
//   category:        Sfx | Ui | Music | Voice (volume groups, WP11.5b), default Sfx
//   looped:          repeat until stopped, default false
//   original_as_is:  true = a mapped original Red Alert sound plays with volume 1, no pitch spread and the
//                    default voice cap instead of this entry's values (which suit the CC0 file), default false
//
// Every file needs a line in assets/LICENSES.md.
(
    sounds: {
        "test_click": (
            file: "audio/sfx/test_click.wav",
            volume: 0.8,
            pitch_variation: 0.05,
            max_instances: 4,
            category: Sfx,
        ),
        // Generic events (WP11.7); ra_mapping.ron can replace them with the
        // player's original Red Alert sounds. Events without a CC0 sound yet
        // (unit.select, unit.move, unit.attack, building.placed) are silent
        // unless mapped.
        "ui.click": (
            file: "audio/sfx/test_click.wav",
            volume: 0.6,
            max_instances: 2,
            category: Ui,
        ),
        // Fight sounds (WP11.3b), one per sound event of effects.ron, generated by
        // tools/sf_sound_gen (own work, CC0; `cargo run -p sf_sound_gen` rewrites the
        // files, a test checks they are current). Every file has the same peak: the
        // volume here is the loudness of the event, set by measuring the mixed peak
        // of a 20-tank fight (`a_20_tank_fight_is_not_louder_than_the_music` in
        // sf_game fx_sound.rs). With Red Alert audio on, ra_mapping.ron still wins
        // for the events it maps; the rest play these.
        "weapon.fire.bullet": (
            file: "audio/sfx/weapon_fire_bullet.wav",
            volume: 0.225,
            pitch_variation: 0.06,
            max_instances: 6,
            category: Sfx,
            original_as_is: true,
        ),
        "weapon.fire.precision": (
            file: "audio/sfx/weapon_fire_precision.wav",
            volume: 0.3,
            pitch_variation: 0.04,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "weapon.fire.cannon": (
            file: "audio/sfx/weapon_fire_cannon.wav",
            volume: 0.3,
            pitch_variation: 0.05,
            max_instances: 6,
            category: Sfx,
            original_as_is: true,
        ),
        "weapon.fire.rocket": (
            file: "audio/sfx/weapon_fire_rocket.wav",
            volume: 0.275,
            pitch_variation: 0.04,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "weapon.fire.shell": (
            file: "audio/sfx/weapon_fire_shell.wav",
            volume: 0.275,
            pitch_variation: 0.05,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "weapon.fire.howitzer": (
            file: "audio/sfx/weapon_fire_howitzer.wav",
            volume: 0.325,
            pitch_variation: 0.03,
            max_instances: 3,
            category: Sfx,
            original_as_is: true,
        ),
        "weapon.fire.demolition": (
            file: "audio/sfx/weapon_fire_demolition.wav",
            volume: 0.25,
            pitch_variation: 0.0,
            max_instances: 2,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.bullet": (
            file: "audio/sfx/impact_bullet.wav",
            volume: 0.15,
            pitch_variation: 0.08,
            max_instances: 6,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.precision": (
            file: "audio/sfx/impact_precision.wav",
            volume: 0.175,
            pitch_variation: 0.05,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.cannon": (
            file: "audio/sfx/impact_cannon.wav",
            volume: 0.25,
            pitch_variation: 0.05,
            max_instances: 6,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.rocket": (
            file: "audio/sfx/impact_rocket.wav",
            volume: 0.275,
            pitch_variation: 0.04,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.shell": (
            file: "audio/sfx/impact_shell.wav",
            volume: 0.25,
            pitch_variation: 0.05,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.demolition": (
            file: "audio/sfx/impact_demolition.wav",
            volume: 0.3,
            pitch_variation: 0.03,
            max_instances: 3,
            category: Sfx,
            original_as_is: true,
        ),
        "impact.miss": (
            file: "audio/sfx/impact_miss.wav",
            volume: 0.125,
            pitch_variation: 0.08,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "unit.destroyed.infantry": (
            file: "audio/sfx/unit_destroyed_infantry.wav",
            volume: 0.2,
            pitch_variation: 0.06,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "explosion.small": (
            file: "audio/sfx/explosion_small.wav",
            volume: 0.25,
            pitch_variation: 0.05,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "explosion.medium": (
            file: "audio/sfx/explosion_medium.wav",
            volume: 0.3,
            pitch_variation: 0.04,
            max_instances: 4,
            category: Sfx,
            original_as_is: true,
        ),
        "explosion.large": (
            file: "audio/sfx/explosion_large.wav",
            volume: 0.35,
            pitch_variation: 0.03,
            max_instances: 3,
            category: Sfx,
            original_as_is: true,
        ),
        // The same file as a looping "music" track, to exercise the crossfade.
        "test_loop": (
            file: "audio/sfx/test_click.wav",
            volume: 0.5,
            category: Music,
            looped: true,
        ),
    },
)
