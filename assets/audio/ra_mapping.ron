// Original Red Alert audio (WP11.7, B11): which of the player's own Red
// Alert sounds replaces which Staalfront sound event. Names only: no audio
// from Red Alert is ever in this repository.
//
// Used only when "Use original Red Alert audio" is on (assets/config/audio.ron
// or `sf_game --ra-audio <path>`). An event whose file is not found keeps
// its CC0 sound from bank.ron (every fight event has one since WP11.3b, the unit
// voices since WP11.2b; building.placed has none and stays silent). A mapped original plays as-is:
// volume 1, no pitch spread, default voice cap (bank entries with original_as_is: true).
//
//   sounds: event -> file name inside the MIX archives ("NAME.AUD", or "NAME.V01" for a voice line), or the
//           raw id "#1A2B3C4D" the F1 sound browser shows for entries whose
//           name it does not know.
//   names:  extra file names the sound browser should show instead of ids.
//   music:  which Red Alert tracks play in the calm and the combat mood (WP11.4). Shipped EMPTY on purpose:
//           Staalfront ships no list of Red Alert file names. An empty list means every track of the music
//           archive (SCORES.MIX, also as a subfolder of an extracted WAV folder), so Red Alert music works
//           out of the box; with both lists empty, calm and combat play the same tracks. To tune the
//           moods, open the F1 sound browser, play the tracks of SCORES.MIX, and list the names (or the
//           "#1A2B3C4D" ids it shows) here, for example
//               music: (calm: ["SOME_TRACK.AUD"], combat: ["#1A2B3C4D", "OTHER_TRACK"]),
//           (made-up names). A name without extension means "<name>.AUD". Several tracks in a list play
//           shuffled. A name that is not found is skipped with one warning; a mood without a playable
//           track uses the default music of audio.ron (`music.fallback`), or silence.

// Voice lines (select, move, attack) never exist as a bare ".AUD" in Red
// Alert: they carry a variant as extension. ".Vnn" is the Allied accent and
// ".Rnn" the Soviet accent; infantry lines use the odd variants (01, 03),
// vehicle lines the even ones (00, 02). The loader looks a name up as
// written, so the extension is part of the name. V01 is a default: pick the
// variant by ear in the F1 sound browser (Sound browser > play) and change it
// here.
(
    sounds: {
        "ui.click": "RAMENU1.AUD",
        "unit.select": "AWAIT1.V01",
        "unit.move": "ACKNO.V01",
        "unit.attack": "AFFIRM1.V01",
        "building.placed": "PLACBLDG.AUD",
        // Announcements (WP11.2c): the status lines of the player's own base. One name per event, checked one
        // fact at a time by onderzoeker (all .AUD files of SPEECH.MIX). When each one plays in Red Alert has NOT
        // been checked: the game raises each event by its own rules (docs/rules/announcements.md). Our own line
        // plays when the file is not found. announce.harvester_under_attack has no Red Alert line (none mapped),
        // so it always plays our own. announce.structure_lost is the closest match only (medium confidence).
        "announce.structure_ready": "CONSCMP1.AUD",
        "announce.unit_ready": "UNITRDY1.AUD",
        "announce.building": "ABLDGIN1.AUD",
        "announce.training": "TRAIN1.AUD",
        "announce.on_hold": "ONHOLD1.AUD",
        "announce.cancelled": "CANCLD1.AUD",
        "announce.base_under_attack": "BASEATK1.AUD",
        "announce.low_power": "LOPOWER1.AUD",
        "announce.insufficient_funds": "NOFUNDS1.AUD",
        "announce.storage_full": "SILOND1.AUD",
        "announce.unit_lost": "UNITLST1.AUD",
        "announce.structure_lost": "STRCKIL1.AUD",
        "announce.new_options": "NEWOPT1.AUD",
        "announce.cannot_deploy": "NODEPLY1.AUD",
        "announce.victory": "MISNWON1.AUD",
        "announce.defeat": "MISNLST1.AUD",
        "announce.structure_sold": "STRUSLD1.AUD",
        "announce.repairing": "REPAIR1.AUD",
        // Fight sounds (28-10-2026): each event matched by role (who fires it, see weapon_defs.ron) to the
        // Red Alert sound of the same role, one fact at a time, checked by onderzoeker; tried by ear by Tijmen.
        // Red Alert has no sound for placing a demolition charge, for bullet hits or for a miss, so
        // weapon.fire.demolition, impact.bullet, impact.precision and impact.miss stay unmapped and
        // play their CC0 sound from bank.ron also with Red Alert audio on (WP11.3b).
        "explosion.small": "KABOOM15.AUD",
        "weapon.fire.bullet": "GUN11.AUD",
        "weapon.fire.precision": "GUN5.AUD",
        "weapon.fire.cannon": "CANNON1.AUD",
        "weapon.fire.rocket": "MISSILE6.AUD",
        "weapon.fire.shell": "TURRET1.AUD",
        "weapon.fire.howitzer": "TANK5.AUD",
        "impact.cannon": "KABOOM12.AUD",
        "impact.rocket": "KABOOM25.AUD",
        "impact.shell": "KABOOM15.AUD",
        "impact.demolition": "KABOOM22.AUD",
        "explosion.medium": "KABOOM22.AUD",
        "explosion.large": "KABOOM22.AUD",
        "unit.destroyed.infantry": "DEDMAN1.AUD",
    },
    names: [
        "MAIN.MIX",
        "REDALERT.MIX",
        "SOUNDS.MIX",
        "SPEECH.MIX",
        "ALLIES.MIX",
        "RUSSIAN.MIX",
        "LOCAL.MIX",
        "CONQUER.MIX",
        "SCORES.MIX",
    ],
    music: (
        calm: [],
        combat: [],
    ),
)
