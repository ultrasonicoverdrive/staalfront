// The computer opponent's profile "normal" (WP9.1a, docs/rules/ai.md). Read and checked by
// sf_data::ai_profile against unit_defs.ron; sf_ai::Profile turns the roles into kinds. Every number is a
// placeholder (design memo 10-11-2026) that WP9.1b and WP9.1c tune against measured matches; the rules that
// USE the numbers are not built yet (WP9.1a only observes), so today only the schedule numbers act.
//
// The build order is a goal list: (role, count) means "have at least `count` of the role". The AI walks the
// list from the top and builds the first entry it does not satisfy, so the order is the opening, the tech
// choice and the rebuild order at once. An entry whose prerequisite (`requires` in unit_defs.ron) is not
// earlier in the list is refused. The shipyard and vessels are out of this profile; the ore silo is a rule
// of the economy (`silo_percent`), not a list entry.
(
    name: "normal",
    // A think runs every `think_interval` ticks: when (tick + stagger * player) % interval == 0, so two
    // players never think on the same tick (checked: interval / gcd(interval, stagger) >= 8 players).
    think_interval: 10,
    stagger: 3,
    economy: (
        // Spare power kept above what the structures use before the next one starts.
        power_margin: 20,
        harvesters_per_refinery: 2,
        // Credits kept back before units are queued while a structure goal is open.
        reserve: 300,
        max_parallel_builds: 1,
        // Build a silo when the ore store is at least this many percent full.
        silo_percent: 90,
        // Repair a structure below this many percent of its hit points.
        repair_below_percent: 70,
        // A role with no place found is skipped for this many ticks.
        blocked_ticks: 600,
        // The most placement previews one think may ask for.
        placement_cap: 256,
    ),
    army: (
        // Attack when the army's value (sum of unit costs) reaches this ...
        attack_value: 3000,
        // ... or after this many ticks since the last attack with at least `min_units` units ...
        max_wait: 3600,
        min_units: 4,
        // ... but never before this tick.
        first_attack_tick: 2400,
        // How long the army defends after a structure was hit.
        defend_ticks: 200,
        // Cells from the base towards the map centre where the army gathers.
        gather_distance: 6,
    ),
    factions: [
        (
            faction: Meridian,
            build_order: [
                ("power_plant", 1),
                ("refinery", 1),
                ("barracks", 1),
                ("power_plant", 2),
                ("vehicle_factory", 1),
                ("defence_tower", 1),
                ("refinery", 2),
                ("radar", 1),
                ("defence_tower", 2),
                ("advanced_defences", 1),
            ],
            // (role, weight): the share of the army each role aims at.
            unit_mix: [("rifleman", 4), ("rocket_trooper", 2), ("light_tank", 3)],
        ),
        (
            faction: Veyran,
            build_order: [
                ("power_plant", 1),
                ("refinery", 1),
                ("barracks", 1),
                ("power_plant", 2),
                ("vehicle_factory", 1),
                ("defence_tower", 1),
                ("fortified_bunker", 1),
                ("refinery", 2),
                ("radar", 1),
                ("defence_tower", 2),
                ("advanced_defences", 1),
            ],
            unit_mix: [("rifleman", 4), ("rocket_trooper", 2), ("light_tank", 3)],
        ),
    ],
)
