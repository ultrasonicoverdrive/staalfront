// The AI frame (WP9.1a, docs/rules/ai.md): a computer opponent that observes through the fog and sends no
// command yet. Player 0 (Meridian) is the AI; player 1 (Veyran) is static. The scenario proves the fence:
// what player 0 has not seen never gets into its observation or its memory.
//
// `unit_defs` names a FROZEN copy of the shipped definitions (ai_fog_defs, made for WP9.1a) with the match
// file of this scenario and a copy of the profile `assets/ai/normal.ron`, so editing the shipped
// definitions or profile never moves this checksum or the AI digest. The scenario has no terrain layer
// (open ground, 96 by 96). The ore, harvest, storage, money and production lines are those of `match`,
// so that the AI sees real credits; no harvester or factory exists here, so nothing is mined or built.
//
// What happens (slots in ai_fog_defs/match.ron):
//   tick 1     the scout (slot 1) walks from (24, 72) to (34, 62); on arrival (about tick 250) it sees the power
//              plant (slot 3) and the barracks (slot 4) of player 1, nothing else
//   tick 500   the barracks is removed; the AI sees its cells without it and forgets it
//   tick 520   the scout walks home to (14, 76); the power plant leaves its sight and stays in the AI's memory
//   never      the construction centre (slot 2), the refinery (slot 5) and the army of player 1 (slots 6 to 8,
//              in the far corner, spawned below) are in shroud for player 0 for the whole run
// The AI thinks every 10 ticks when tick % 10 == 0 (player 0, stagger 3); one manager per think.
Scenario(
    name: "ai_fog",
    seed: 0xA1F0_0091,
    map: (width: 96, height: 96),
    unit_defs: Some("ai_fog_defs"),
    match_file: Some("match.ron"),
    ai: [(player: 0, profile: "normal.ron", seed: 0xA1_0001)],
    buildings: true,
    combat: true,
    targeting: true,
    destruction: true,
    ore: Some((start: 120, max: 160, regrow_amount: 1, regrow_period: 200)),
    harvest: Some((
        harvesters: [11],
        capacity: 200,
        mine_amount: 4,
        mine_period: 8,
        unload_amount: 10,
        unload_period: 4,
        search_radius: 40,
        retry_period: 100,
        call_range: 6,
        grant_timeout: 400,
        call_timeout: 10,
        max_tries: 3,
        park_distance: 4,
        park_spread: 5,
        park_near_tenths: 20,
        mine_start_tenths: 10,
        mine_reach_tenths: 15,
        mine_lose_tenths: 25,
        dock_reach_tenths: 20,
        travel_cost: 16,
        queue_cost: 100,
        switch_margin: 100,
        recheck_period: 20,
        queue_gap: 3,
        queue_start: 1,
        queue_step: 2,
        queue_rows: 8,
    )),
    storage: Some([(2, 600)]),
    money: Some((credits_per_ore: 1)),
    production: Some((queue_limit: 5, exit_radius: 4)),
    power: Some((shortage_floor_permille: 250, defence_cutoff_permille: 1000)),
    vision: Some((legacy_sight_milli: 5000, acquire_needs_sight: true)),
    ticks: 800,
    commands: [
        // The army of player 1, in the far south-east corner.
        (tick: 0, player: 1, command: SpawnUnit(kind: 12, owner: 1, cell: (90, 90))),
        (tick: 0, player: 1, command: SpawnUnit(kind: 12, owner: 1, cell: (91, 90))),
        (tick: 0, player: 1, command: SpawnUnit(kind: 19, owner: 1, cell: (90, 91))),
        // The scout's walk.
        (tick: 1, player: 0, command: OrderMove(ids: [Id(1, 0)], target: (34, 62))),
        (tick: 500, player: 1, command: Despawn(ids: [Id(4, 0)])),
        (tick: 520, player: 0, command: OrderMove(ids: [Id(1, 0)], target: (14, 76))),
    ],
)
