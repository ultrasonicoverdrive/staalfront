// The AI boxed in (WP9.1b-1, docs/rules/ai.md, "No hang"): the scenario `ai_base` on a copy of the first
// match's map with rock round the construction centre (`assets/maps/m1_boxed`, gen_ai_maps.rs): a pocket of
// x 5..17, y 66..73 holds the centre, so small structures fit west of it and a refinery fits nowhere. The
// refinery is blocked for `blocked_ticks` again and again, and the later goals that do not need it (the
// barracks, the second power plant, the defence towers) are built all the same. Runs on `ai_base_defs`.
Scenario(
    name: "ai_boxed",
    seed: 0xA1_BA5E,
    map: (width: 96, height: 96),
    map_name: Some("m1_boxed"),
    unit_defs: Some("ai_base_defs"),
    match_file: Some("match.ron"),
    ai: [(player: 0, profile: "normal.ron", seed: 0xA1_0001)],
    buildings: true,
    combat: true,
    targeting: true,
    destruction: true,
    ore: Some((start: 120, max: 160, regrow_amount: 1, regrow_period: 200)),
    harvest: Some((
        harvesters: [11],
        capacity: 200,
        mine_amount: 4,
        mine_period: 8,
        unload_amount: 10,
        unload_period: 4,
        search_radius: 40,
        retry_period: 100,
        call_range: 6,
        grant_timeout: 400,
        call_timeout: 10,
        max_tries: 3,
        park_distance: 4,
        park_spread: 5,
        park_near_tenths: 20,
        mine_start_tenths: 10,
        mine_reach_tenths: 15,
        mine_lose_tenths: 25,
        dock_reach_tenths: 20,
        travel_cost: 16,
        queue_cost: 100,
        switch_margin: 100,
        recheck_period: 20,
        queue_gap: 3,
        queue_start: 1,
        queue_step: 2,
        queue_rows: 8,
    )),
    storage: Some([(2, 2000), (43, 1500)]),
    money: Some((credits_per_ore: 1)),
    production: Some((queue_limit: 5, exit_radius: 4, build_speed: (3, 2))),
    power: Some((shortage_floor_permille: 250, defence_cutoff_permille: 1000)),
    vision: Some((legacy_sight_milli: 5000, acquire_needs_sight: true)),
    ticks: 8000,
    commands: [],
)
