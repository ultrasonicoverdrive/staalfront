        (tick: 0, command: SpawnUnit(kind: 20, owner: 1, cell: (6, 24))),
        (tick: 0, command: SpawnUnit(kind: 19, owner: 1, cell: (5, 22))),
        (tick: 0, command: PlaceStructure(kind: 40, owner: 1, cell: (6, 21))),
        (tick: 0, command: SpawnUnit(kind: 13, owner: 1, cell: (6, 20))),
        (tick: 0, command: SpawnUnit(kind: 12, owner: 0, cell: (6, 23))),
