                    (at: 6300, kind: Dialogue(speaker: "major_halversen", text: "Two bridges. We can't hold both. The engineers can drop the west one, but they need twelve minutes and nobody shooting at them.", duration_ms: 9200, voice: None, lipsync: None, delivery: OnScreen)),  // line 25
