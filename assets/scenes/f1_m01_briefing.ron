                events: [
                    (at: 2200, kind: Dialogue(speaker: "captain_elian", text: "The relay went dark at 04:10. By dawn, every unit north of the ridge was operating on stale orders.", duration_ms: 7600, voice: None, lipsync: None, delivery: OnScreen)),  // line 17; hand edit: starts at 2200 ms (importer 2000 ms), starts when Elian has walked in
                    (at: 10100, kind: Dialogue(speaker: "mira", text: "Operating on nothing, Captain. The garrison has not acknowledged a message since the relay stopped.", duration_ms: 6000, voice: None, lipsync: None, delivery: OnScreen)),  // line 21; hand edit: starts at 10100 ms (importer 9900 ms)
                    (at: 16900, kind: Dialogue(speaker: "mira", text: "Scouts report a small hostile camp around the junction. No heavy armour yet.", duration_ms: 5200, voice: None, lipsync: None, delivery: OnScreen)),  // line 28; hand edit: starts at 16900 ms (importer 16200 ms), half a second to read the map first
                    (at: 22600, kind: Dialogue(speaker: "captain_elian", text: "Then we move before they can reinforce it. Establish a base, secure the junction, and keep the relay road open.", duration_ms: 8000, voice: None, lipsync: None, delivery: OnScreen)),  // line 32; hand edit: starts at 22600 ms (importer 21700 ms), half a second after the cut back
                    (at: 30900, kind: Dialogue(speaker: "mira", text: "We have one construction center and five rifles. Power first, then barracks, or we are a camp ourselves.", duration_ms: 7200, voice: None, lipsync: None, delivery: OnScreen)),  // line 36; hand edit: starts at 30900 ms (importer 30000 ms)
                    (at: 38400, kind: Dialogue(speaker: "captain_elian", text: "The ore is on the ridge. Get a harvester working before the fight starts, not during it.", duration_ms: 6800, voice: None, lipsync: None, delivery: OnScreen)),  // line 40; hand edit: starts at 38400 ms (importer 37500 ms)
                    (at: 46100, kind: Dialogue(speaker: "mira", text: "One thing I cannot explain. The camp sits on a junction that has no value unless someone knew we were coming here.", duration_ms: 8800, voice: None, lipsync: None, delivery: OnScreen)),  // line 44; hand edit: starts at 46100 ms (importer 44600 ms), a longer pause before the twist
                    (at: 55500, kind: Dialogue(speaker: "captain_elian", text: "Note it. Take the junction and we will read what they left behind.", duration_ms: 5200, voice: None, lipsync: None, delivery: OnScreen)),  // line 48; hand edit: starts at 55500 ms (importer 53700 ms), a beat after Mira's doubt
