        (name: "forward_command_post_dawn_door_frame", art: RoundRect(w: 430.0, h: 620.0, radius: 40.0, color: "#5b5238"), pos: (-640.0, -60.0), parallax: 0.6, z: -38, shots: ["forward_command_post_dawn"]),  // the tent flap, open on the dawn
        (name: "forward_command_post_dawn_dawn_sky", art: RoundRect(w: 380.0, h: 570.0, radius: 28.0, color: "#ecc79b"), pos: (-640.0, -60.0), parallax: 0.6, z: -37, shots: ["forward_command_post_dawn"]),
